---
networks:
  {{ bwpm_network_name }}:
    driver: bridge
    ipam:
        driver: default
        config:
            - subnet: {{ bwpm_subnet }}

services:
  {{ bwpm_db_name }}:
    container_name: {{ bwpm_db_name }}
    image: {{ bwpm_db_image }}
    volumes:
        - {{ bwpm_db_volume }}:/var/lib/mariadb
    networks:
      {{ bwpm_network_name }}:
        ipv4_address: {{ bwpm_db_ip }}
    expose:
        - {{ bwpm_db_expose }}
    restart: no
    environment:
        MARIADB_ROOT_PASSWORD_FILE: /run/secrets/db_root_password
        MARIADB_DATABASE: joomlatest
        MARIADB_USER: tester
        MARIADB_PASSWORD_FILE: /run/secrets/db_password
    healthcheck:
        test: ["CMD", "healthcheck.sh", "--datadir=/var/lib/mariadb", "--connect"]
        start_period: 30s
        interval: 10s
        timeout: 5s
        retries: 3
    secrets:
        - db_root_password
        - db_password


  {{ bwpm_joomla_name }}:
    container_name: {{ bwpm_joomla_name }}
    build:
        network: host
    volumes:
        # mount webserver root
        - {{ bwpm_joomla_volume }}:/var/www/html
        # mount Joomla configuration
        - type: bind
          source: {{ bwpm_base_path }}/configuration.php
          target: /var/www/html/configuration.php
        # mount logs folder
        - type: bind
          source: {{ bwpm_base_path }}/logs/bwpostman
          target: /var/www/html/administrator/logs/bwpostman
    ports:
        - {{ bwpm_joomla_ports  }}
    healthcheck:
        test: curl --fail http://{{ bwpm_joomla_ip }}/index.php || exit 1
        start_period: 5s
        interval: 10s
        timeout: 10s
        retries: 5
    networks:
      {{ bwpm_network_name }}:
        ipv4_address: {{ bwpm_joomla_ip }}
    depends_on:
      {{ bwpm_db_name }}:
        condition: service_healthy
    secrets:
        - j_root_password
        - db_password
        - db_root_password

  {{ bwpm_pma_name }}:
    container_name: {{ bwpm_pma_name }}
    image: phpmyadmin
    networks:
      {{ bwpm_network_name }}:
        ipv4_address: {{ bwpm_pma_ip }}
    healthcheck:
        #    See https://stackoverflow.com/questions/67904609/how-do-you-perform-a-healthcheck-in-the-redis-docker-image
        test: curl --fail http://{{ bwpm_pma_ip }}/LICENSE || exit 1
        start_period: 10s
        interval: 10s
        timeout: 5s
        retries: 3
    environment:
        JOOMLA_DB_HOST: {{ bwpm_db_ip }}
        PMA_HOST: {{ bwpm_db_ip }}
    depends_on:
      {{ bwpm_db_name }}:
        condition: service_healthy
    expose:
        - 6579
    restart: no

volumes:
  {{ bwpm_db_volume }}:
  {{ bwpm_joomla_volume }}:

secrets:
    db_password:
        file: ../files/db_password.txt
    db_root_password:
        file: ../files/db_root_password.txt
    j_root_password:
        file: ../files/j_root_password.txt
