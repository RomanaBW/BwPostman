						always {
//							echo "Dummy 4 always"
							sh "ansible-playbook -i ${WORKSPACE}/build/playbooks/inventory/hosts ${WORKSPACE}/build/playbooks/stop-acceptance-tests.yml --extra-vars 'test_suite=accept4 ${VERSIONS_EXTRA_VAR_CURRENT}'"
						}
						failure {
							bwpmAcceptFailureContainer ("Suite_PREVIOUS", "${PROJECT_NAME_CURRENT}")
						}
					}
				}
			}
		}


		stage('Remove acceptance tests container images for J6') {
