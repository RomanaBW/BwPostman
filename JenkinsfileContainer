pipeline {
    agent { label 'Tester' }

    stages {
        stage('Set variables') {
			steps {
				script {
					BWPM_VERSION = "4.3.3"

					JOOMLA_VERSION_PREVIOUS = "5.4.0"
					JOOMLA_VERSION_CURRENT = "6.0.0"

					DO_CURRENT_SMOKE  = 'true'
					DO_CURRENT_ACCEPT = 'true'
					DO_CURRENT_PERMS  = 'true'

					DO_PREVIOUS_SMOKE  = 'true'
					DO_PREVIOUS_ACCEPT = 'true'
					DO_PREVIOUS_PERMS  = 'true'

					DO_DEV_UPLOAD = 'true'
					PACK_PACKAGE  = 'false'

					PHP_VERSION_PREVIOUS = "8.1.0"
					PHP_VERSION_CURRENT = "8.3.0"

					GIT_MESSAGE = "not specified"

					PROJECT_NAME_PREVIOUS = "j${JOOMLA_VERSION_PREVIOUS}_bwpm${BWPM_VERSION}"
					PROJECT_NAME_CURRENT = "j${JOOMLA_VERSION_CURRENT}_bwpm${BWPM_VERSION}"

					VERSIONS_EXTRA_VAR_PREVIOUS = "joomla_version=${JOOMLA_VERSION_PREVIOUS} bwpm_version=${BWPM_VERSION} php_selected_version=${PHP_VERSION_PREVIOUS}";
					VERSIONS_EXTRA_VAR_CURRENT = "joomla_version=${JOOMLA_VERSION_CURRENT} bwpm_version=${BWPM_VERSION} php_selected_version=${PHP_VERSION_CURRENT}";

					DO_RECORD_SMOKE = "true";
					DO_RECORD_1 = "false";
					DO_RECORD_2 = "false";
					DO_RECORD_3 = "false";
					DO_RECORD_4 = "true";
					DO_RECORD_5 = "false";
					DO_RECORD_6 = "false";
					DO_RECORD_7 = "false";
				}
			}
        }

		stage('Create full package') {
			when {
				expression {
					return PACK_PACKAGE == 'true'
				}
			}
			steps {
				sh "ansible-playbook -i ${WORKSPACE}/build/playbooks/inventory/hosts ${WORKSPACE}/build/playbooks/build_package.yml --extra-vars 'project_base_dir=${WORKSPACE} version_number=${BWPM_VERSION} build=${BUILD_NUMBER} mb4_support=true replace_vars=true'"
			}
		}


		stage('Run smoke tests with J6') {
			when {
				expression {
					return DO_CURRENT_SMOKE == 'true'
				}
			}
			steps {
//				echo "Dummy Smoke"
				sh "ansible-playbook -i ${WORKSPACE}/build/playbooks/inventory/hosts ${WORKSPACE}/build/playbooks/run-smoke-tests.yml --extra-vars 'project_base_dir=${WORKSPACE} do_record=${DO_RECORD_SMOKE} ${VERSIONS_EXTRA_VAR_CURRENT}'"
				sh "docker exec -t bwpm_enh_tester-5 /data/do-tests.sh ${BWPM_VERSION}"
				sh "ansible-playbook -i ${WORKSPACE}/build/playbooks/inventory/hosts ${WORKSPACE}/build/playbooks/push-smoke-testers.yml --extra-vars '${VERSIONS_EXTRA_VAR_CURRENT}'"
			}
			post {
					always {
					echo "Dummy Smoke ALWAYS"
//					sh "ansible-playbook -i ${WORKSPACE}/build/playbooks/inventory/hosts ${WORKSPACE}/build/playbooks/stop-smoke-tests.yml --extra-vars '${VERSIONS_EXTRA_VAR_CURRENT}'"
				}
				failure {
					bwpmAcceptFailureContainer ("Smoke", "${PROJECT_NAME_CURRENT}")
				}
			}
		}

		stage('Remove smoke tests container images J6') {
			when {
				expression {
					return DO_CURRENT_SMOKE == 'true'
				}
			}
			steps {
				echo "Dummy Smoke Remove"
//				sh "ansible-playbook -i ${WORKSPACE}/build/playbooks/inventory/hosts ${WORKSPACE}/build/playbooks/remove-smoke-images.yml --extra-vars 'test_suite=accept1 ${VERSIONS_EXTRA_VAR_CURRENT}'"
            }
		}

		stage('Run acceptance Joomla 6') {
			when {
				expression {
					return DO_CURRENT_ACCEPT == 'true'
				}
			}
			parallel {
				stage('A5-1: Lists NLS, TPLS, SUBS') {
					steps {
//						echo "Dummy 1"
						sh "ansible-playbook -i ${WORKSPACE}/build/playbooks/inventory/hosts ${WORKSPACE}/build/playbooks/run-acceptance-tests.yml --extra-vars 'project_base_dir=${WORKSPACE} test_suite=accept1 do_record=${DO_RECORD_1} ${VERSIONS_EXTRA_VAR_CURRENT}'"
						sh "docker exec -t bwpm_accept1_tester-5 /data/do-tests.sh ${BWPM_VERSION}"
					}
					post {
						always {
//							echo "Dummy 1 always"
							sh "ansible-playbook -i ${WORKSPACE}/build/playbooks/inventory/hosts ${WORKSPACE}/build/playbooks/stop-acceptance-tests.yml --extra-vars 'test_suite=accept1 ${VERSIONS_EXTRA_VAR_CURRENT}'"
						}
						failure {
							bwpmAcceptFailureContainer ("Suite_1", "${PROJECT_NAME_CURRENT}")
						}
					}
				}
				stage('A5-2: Details NL, SUB') {
					steps {
//						echo "Dummy 2"
